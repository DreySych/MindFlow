[MASTER]
ignore=migrations,__pycache__,media,staticfiles,logs
load-plugins=

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    duplicate-code,
    import-error,
    invalid-name,
    no-member,
    broad-exception-caught,
    too-many-return-statements,
    too-many-branches,
    too-many-instance-attributes,
    super-init-not-called,
    global-statement,
    C0411,
    C0412,
    W0613,
    W0201,
    R1705,
    R0904,
    W0237,
    W0221,
    C0415,
    W0404,
    W0707,
    R1732,
    W0612,
    W0611

[FORMAT]
max-line-length=120

[DESIGN]
max-args=10
max-locals=25
max-branches=20
max-statements=60